{
    "permissions": {
        "allow": [
            "mcp__cds-mcp"
        ],
        "deny": [
            "Read(./.env)",
            "Read(./.env.*)",
            "Read(./default-env.json)",
            "Read(./default-services.json)",
            "Read(./**/*.key)",
            "Read(./**/*.pem)",
            "Read(./**/*.p12)",
            "Edit(./.env)",
            "Edit(./.env.*)",
            "Write(./.env)",
            "Write(./.env.*)",
            "Edit(./default-env.json)",
            "Write(./default-env.json)",
            "Edit(./gen/**)",
            "Write(./gen/**)",
            "Bash(cf env:*)",
            "Bash(cf service-key:*)",
            "Bash(cf create-service-key:*)",
            "Bash(cf curl:*)",
            "Bash(cat .env:*)",
            "Bash(cat default-env.json:*)"
        ],
        "ask": [
            "Edit(./xs-security.json)",
            "Write(./xs-security.json)",
            "Edit(./mta.yaml)",
            "Write(./mta.yaml)",
            "Edit(./package.json)",
            "Write(./package.json)",
            "Edit(./CLAUDE.md)",
            "Write(./CLAUDE.md)",
            "Edit(./.claude/**)",
            "Write(./.claude/**)",
            "Bash(rm:*)",
            "Bash(git clean:*)",
            "Bash(git reset --hard:*)",
            "Bash(git push:*)",
            "Bash(cf deploy:*)",
            "Bash(cf delete:*)",
            "Bash(cf undeploy:*)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-sensitive-delete.sh"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Edit|Write|MultiEdit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/cds-compile-check.sh"
                    }
                ]
            }
        ]
    }
}