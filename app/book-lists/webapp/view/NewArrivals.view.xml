<mvc:View
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:mvc="sap.ui.core.mvc"
    core:require="{Currency: 'sap/ui/model/type/Currency'}"
    controllerName="com.bookstore.booklists.view.BookList">
    <Page title="{i18n>newArrivalsTitle}" showNavButton="true" navButtonPress=".onNavBack">
        <subHeader>
            <Toolbar>
                <Text text="{i18n>newArrivalsSubtitle}" />
            </Toolbar>
        </subHeader>
        <List
            id="bookList"
            class="booklistsList"
            showSeparators="None"
            noDataText="{i18n>noNewArrivals}"
            items="{path: '/NewArrivals', sorter: {path: 'createdAt', descending: true}}">
            <CustomListItem class="booklistsCard">
                <HBox class="sapUiSmallMargin">
                    <Image src="{imageUrl}" alt="{title}" class="booklistsCover sapUiSmallMarginEnd" width="6rem" height="9rem" densityAware="false" visible="{= !!${imageUrl}}" />
                    <VBox>
                        <Title text="{title}" titleStyle="H3" />
                        <Text class="sapUiTinyMarginTopBottom" text="{descr}" />
                        <ObjectNumber emphasized="true" number="{parts: [{path: 'price'}, {value: 'EUR'}], type: 'Currency', formatOptions: {currencyCode: false}}" />
                    </VBox>
                </HBox>
            </CustomListItem>
        </List>
    </Page>
</mvc:View>
