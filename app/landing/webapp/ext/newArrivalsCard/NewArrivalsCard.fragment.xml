<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <List
        id="newArrivalsList"
        growing="true"
        growingThreshold="5"
        noDataText="{@i18n>noNewArrivals}"
        items="{path: 'mainModel>/NewArrivals', sorter: {path: 'createdAt', descending: true}}">
        <CustomListItem>
            <HBox class="sapUiTinyMargin" alignItems="Center">
                <Image
                    src="{mainModel>imageUrl}"
                    alt="{mainModel>title}"
                    class="bookstoreCover sapUiSmallMarginEnd"
                    width="3rem"
                    height="4.5rem"
                    visible="{= !!${mainModel>imageUrl}}" />
                <VBox>
                    <Title text="{mainModel>title}" titleStyle="H5" />
                    <ObjectNumber
                        number="{parts: [{path: 'mainModel>price'}, {value: 'EUR'}], type: 'sap.ui.model.type.Currency', formatOptions: {currencyCode: false}}" />
                </VBox>
            </HBox>
        </CustomListItem>
    </List>
</core:FragmentDefinition>
