<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <List
        id="storeInfoList"
        showSeparators="None"
        noDataText="{@i18n>noStoreInfo}"
        items="{path: 'mainModel>/StoreInfo', length: 1}">
        <CustomListItem>
            <VBox class="sapUiTinyMargin">
                <HBox class="bookstoreStoreImages">
                    <Image
                        src="/com.bookstore.landing/images/store-front.svg"
                        alt="{@i18n>storeFrontImageAlt}"
                        class="bookstoreStoreImage"
                        width="100%"
                        height="7rem"
                        densityAware="false" />
                    <Image
                        src="/com.bookstore.landing/images/reading-corner.svg"
                        alt="{@i18n>readingCornerImageAlt}"
                        class="bookstoreStoreImage"
                        width="100%"
                        height="7rem"
                        densityAware="false" />
                </HBox>
                <VBox class="sapUiSmallMarginTop">
                    <Title text="{mainModel>name}" titleStyle="H5" />
                    <ObjectStatus class="sapUiTinyMarginTop" icon="sap-icon://addresses" text="{mainModel>address}" />
                    <ObjectStatus class="sapUiTinyMarginTop" icon="sap-icon://date-time" text="{mainModel>openingHours}" />
                    <ObjectStatus class="sapUiTinyMarginTop" icon="sap-icon://phone" text="{mainModel>phone}" />
                </VBox>
            </VBox>
        </CustomListItem>
    </List>
</core:FragmentDefinition>
