<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <VBox>
        <List
            id="heroList"
            showSeparators="None"
            noDataText="{@i18n>noStoreInfo}"
            items="{path: 'mainModel>/StoreInfo', length: 1}">
            <CustomListItem>
                <VBox class="bookstoreHero">
                    <VBox class="sapUiSmallMargin">
                        <Title text="{mainModel>name}" titleStyle="H2" />
                        <Text text="{mainModel>description}" />
                        <VBox class="bookstoreQuote sapUiSmallMarginTop">
                            <FormattedText htmlText="{@i18n>heroWhyBooks}" />
                        </VBox>
                        <VBox class="bookstoreQuote sapUiSmallMarginTop">
                            <FormattedText class="bookstoreQuoteText" htmlText="{@i18n>heroQuote1}" />
                        </VBox>
                        <VBox class="bookstoreQuote sapUiSmallMarginTop">
                            <FormattedText class="bookstoreQuoteText" htmlText="{@i18n>heroQuote2}" />
                        </VBox>
                    </VBox>
                </VBox>
            </CustomListItem>
        </List>
        <Link class="sapUiSmallMarginBegin sapUiSmallMarginBottom" href="website/index.html" text="{@i18n>visitWebsite}" />
    </VBox>
</core:FragmentDefinition>
