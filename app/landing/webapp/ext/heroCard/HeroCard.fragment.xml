<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <List
        id="heroList"
        showSeparators="None"
        noDataText="{@i18n>noStoreInfo}"
        items="{path: 'mainModel>/StoreInfo', length: 1}">
        <CustomListItem>
            <VBox class="bookstoreHero">
                <Image
                    src="{mainModel>heroImageUrl}"
                    decorative="true"
                    class="bookstoreHeroImage"
                    width="100%"
                    height="8rem"
                    densityAware="false"
                    visible="{= !!${mainModel>heroImageUrl}}" />
                <VBox class="sapUiSmallMargin">
                    <Title text="{mainModel>name}" titleStyle="H2" />
                    <Text text="{mainModel>description}" />
                </VBox>
            </VBox>
        </CustomListItem>
    </List>
</core:FragmentDefinition>
