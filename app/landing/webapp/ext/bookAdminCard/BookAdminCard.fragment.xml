<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <!-- Shown to BookAdmin users only (LandingService.isBookAdmin). Visibility is a convenience: AdminService enforces the role. -->
    <VBox visible="{bookAdmin>/isBookAdmin}" class="sapUiSmallMargin">
        <GenericTile
            header="{@i18n>bookAdminTileTitle}"
            subheader="{@i18n>bookAdminTileSubtitle}"
            press=".onOpenBookAdmin">
            <TileContent>
                <ImageContent src="sap-icon://settings" />
            </TileContent>
        </GenericTile>
    </VBox>
</core:FragmentDefinition>
