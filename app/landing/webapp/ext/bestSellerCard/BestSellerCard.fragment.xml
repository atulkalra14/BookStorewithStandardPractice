<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <VBox>
        <List
            id="bestSellerList"
            growing="true"
            growingThreshold="5"
            noDataText="{@i18n>noBestSellers}"
            items="{path: 'mainModel>/BestSellers', length: 5, sorter: {path: 'sold', descending: true}}">
            <CustomListItem>
                <HBox class="sapUiTinyMargin" alignItems="Center">
                    <Image
                        src="{mainModel>imageUrl}"
                        alt="{mainModel>title}"
                        class="bookstoreCover sapUiSmallMarginEnd"
                        width="3rem"
                        height="4.5rem"
                        visible="{= !!${mainModel>imageUrl}}" />
                    <VBox>
                        <Title text="{mainModel>title}" titleStyle="H5" />
                        <ObjectNumber
                            state="Information"
                            emphasized="true"
                            number="{mainModel>sold}"
                            unit="{= Number(${mainModel>sold}) === 1 ? ${@i18n>copySoldUnit} : ${@i18n>copiesSoldUnit}}" />
                    </VBox>
                </HBox>
            </CustomListItem>
        </List>
        <Link class="sapUiSmallMarginBegin sapUiSmallMarginBottom" href="../com.bookstore.booklists/index.html#/best-sellers" text="{@i18n>showAllBestSellers}" />
    </VBox>
</core:FragmentDefinition>
