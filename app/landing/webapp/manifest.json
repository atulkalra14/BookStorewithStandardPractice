{
  "_version": "1.89.0",
  "sap.app": {
    "id": "com.bookstore.landing",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:ovp",
      "version": "1.33.0",
      "toolsId": "cb6b328d-7787-43be-8e27-0c3846c31ed2"
    },
    "dataSources": {
      "mainService": {
        "uri": "/odata/v4/landing/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.153.0",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.ovp": {},
        "sap.ui.rta": {},
        "sap.ui.layout": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.bookstore.landing.i18n.i18n",
          "supportedLocales": [
            "en",
            "de"
          ],
          "fallbackLocale": "en"
        }
      },
      "mainModel": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties",
        "settings": {
          "supportedLocales": [
            "en",
            "de"
          ],
          "fallbackLocale": "en"
        }
      }
    },
    "resources": {
      "css": [
        {
          "uri": "ext/discountCard/discountCard.css"
        },
        {
          "uri": "ext/landing.css"
        }
      ]
    },
    "routing": {
      "config": {},
      "routes": [],
      "targets": {}
    }
  },
  "sap.ovp": {
    "globalFilterModel": "mainModel",
    "containerLayout": "resizable",
    "enableLiveFilter": true,
    "considerAnalyticalParameters": false,
    "globalFilterControlType": "MacroFilterBar",
    "cards": {
      "hero": {
        "model": "mainModel",
        "template": "com.bookstore.landing.ext.heroCard",
        "settings": {
          "targetUri": "../../com.bookstore.landing/website/index.html",
          "title": "{{heroTitle}}",
          "entitySet": "StoreInfo",
          "defaultSpan": {
            "rows": 22,
            "cols": 2
          }
        }
      },
      "quickLinks": {
        "model": "mainModel",
        "template": "sap.ovp.cards.v4.linklist",
        "settings": {
          "title": "{{quickLinksTitle}}",
          "listFlavor": "standard",
          "defaultSpan": {
            "rows": 22,
            "cols": 1
          },
          "staticContent": [
            {
              "title": "{{browseBooksTitle}}",
              "subTitle": "{{browseBooksSubtitle}}",
              "imageUri": "sap-icon://search",
              "imageAltText": "{{browseBooksIcon}}",
              "targetUri": "../../com.bookstore.bookshop/index.html",
              "openInNewWindow": false
            },
            {
              "title": "{{orderBooksTitle}}",
              "subTitle": "{{orderBooksSubtitle}}",
              "imageUri": "sap-icon://cart",
              "imageAltText": "{{orderBooksIcon}}",
              "targetUri": "../../com.bookstore.orders/index.html",
              "openInNewWindow": false
            },
            {
              "title": "{{purchaseHistoryTitle}}",
              "subTitle": "{{purchaseHistorySubtitle}}",
              "imageUri": "sap-icon://history",
              "imageAltText": "{{purchaseHistoryIcon}}",
              "targetUri": "../../com.bookstore.purchasehistory/index.html",
              "openInNewWindow": false
            },
            {
              "title": "{{returnBooksTitle}}",
              "subTitle": "{{returnBooksSubtitle}}",
              "imageUri": "sap-icon://undo",
              "imageAltText": "{{returnBooksIcon}}",
              "targetUri": "../../com.bookstore.returns/index.html",
              "openInNewWindow": false
            }
          ]
        }
      },
      "storeInfo": {
        "model": "mainModel",
        "template": "com.bookstore.landing.ext.storeInfoCard",
        "settings": {
          "targetUri": "../../com.bookstore.landing/website/about.html",
          "title": "{{storeInfoTitle}}",
          "subTitle": "{{storeInfoSubtitle}}",
          "entitySet": "StoreInfo",
          "defaultSpan": {
            "rows": 20,
            "cols": 1
          }
        }
      },
      "discounts": {
        "model": "mainModel",
        "template": "com.bookstore.landing.ext.discountCard",
        "settings": {
          "targetUri": "../../com.bookstore.booklists/index.html#/discounts",
          "title": "{{discountsTitle}}",
          "subTitle": "{{discountsSubtitle}}",
          "entitySet": "ActiveDiscounts"
        }
      },
      "newArrivals": {
        "model": "mainModel",
        "template": "com.bookstore.landing.ext.newArrivalsCard",
        "settings": {
          "targetUri": "../../com.bookstore.booklists/index.html#/new-arrivals",
          "title": "{{newArrivalsTitle}}",
          "subTitle": "{{newArrivalsSubtitle}}",
          "entitySet": "NewArrivals"
        }
      },
      "bestSellers": {
        "model": "mainModel",
        "template": "com.bookstore.landing.ext.bestSellerCard",
        "settings": {
          "targetUri": "../../com.bookstore.booklists/index.html#/best-sellers",
          "title": "{{bestSellersTitle}}",
          "subTitle": "{{bestSellersSubtitle}}",
          "entitySet": "BestSellers"
        }
      }
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "analytical"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
