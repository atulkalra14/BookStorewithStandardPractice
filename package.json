{
  "name": "BookStoreWithStandardPractices",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^24"
  },
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10",
    "@sap/cds-common-content": "^3.2.0",
    "@sap/cds-mtxs": "^4",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1",
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0",
    "eslint": "^10",
    "jest": "^30"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "lint": "eslint .",
    "i18n:check": "node scripts/check-i18n.js --languages=en,de",
    "watch-book-shop": "cds watch --open \"com.bookstore.bookshop/index.html?sap-ui-xx-viewCache=false\" --livereload false",
    "watch-landing": "cds watch --open \"com.bookstore.landing/index.html?sap-ui-xx-viewCache=false\" --livereload false",
    "watch-orders": "cds watch --open com.bookstore.orders/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-purchase-history": "cds watch --open \"com.bookstore.purchasehistory/index.html?sap-ui-xx-viewCache=false\" --livereload false",
    "watch-returns": "cds watch --open com.bookstore.returns/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 20000,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/gen/"
    ]
  },
  "private": true,
  "cds": {
    "requires": {
      "auth": {
        "[development]": {
          "kind": "mocked",
          "users": {
            "alice": {
              "tenant": "t1",
              "roles": [
                "BookViewer",
                "BookAdmin",
                "Customer"
              ]
            },
            "bob": {
              "tenant": "t1",
              "roles": []
            },
            "carol": {
              "tenant": "t2",
              "roles": [
                "BookViewer"
              ]
            },
            "dave": {
              "tenant": "t1",
              "roles": [
                "BookAdmin"
              ]
            },
            "erin": {
              "tenant": "t2",
              "roles": [
                "BookAdmin"
              ]
            },
            "frank": {
              "tenant": "t1",
              "roles": [
                "BookAdmin"
              ]
            },
            "gina": {
              "tenant": "t1",
              "roles": [
                "Customer"
              ]
            },
            "hugo": {
              "tenant": "t1",
              "roles": [
                "Customer"
              ]
            },
            "ivy": {
              "tenant": "t2",
              "roles": [
                "Customer"
              ]
            },
            "*": false
          }
        }
      },
      "[production]": {
        "auth": "xsuaa",
        "multitenancy": true
      },
      "[with-mtx]": {
        "multitenancy": true
      }
    },
    "profile": "with-mtx-sidecar"
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/book-shop",
    "app/landing",
    "app/orders",
    "app/purchase-history",
    "app/returns"
  ]
}
